---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import IssueContent from '../components/IssueContent.astro';

interface Props {
  issue: CollectionEntry<'issues'>['data'];
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { issue, prev, next } = Astro.props;
---

<BaseLayout title={issue.title}>
  <IssueContent issue={issue} prev={prev} next={next} />
</BaseLayout>
