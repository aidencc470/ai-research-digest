---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="site-title"><a href="/">AI Research Digest</a></div>
        <nav class="site-nav">
          <a href="/archive">Archive</a>
        </nav>
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <p>
          AI Research Digest — an automated weekly roundup of AI papers (via arXiv) and lab
          announcements (OpenAI, Google DeepMind).
        </p>
      </div>
    </footer>
  </body>
</html>
