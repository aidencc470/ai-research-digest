---
import type { NormalizedItem } from '../../pipeline/types';

interface Props {
  paper: NormalizedItem;
  rank: number;
}

const { paper, rank } = Astro.props;

function firstSentence(text: string, maxLength = 200): string {
  const match = text.match(/^.*?[.!?](?=\s|$)/);
  let sentence = match ? match[0] : text;
  if (sentence.length > maxLength) {
    sentence = `${sentence.slice(0, maxLength).trimEnd()}…`;
  }
  return sentence;
}
---

<article class="card highlight-card">
  <span class="highlight-rank">{rank}</span>
  <h3><a href={paper.url} target="_blank" rel="noopener">{paper.title}</a></h3>
  {paper.summary && <p class="card-summary">{firstSentence(paper.summary)}</p>}
  <p class="card-links">
    <a href={paper.url} target="_blank" rel="noopener">Read paper →</a>
  </p>
</article>
