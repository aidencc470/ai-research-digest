---
interface Props {
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { prev, next } = Astro.props;
---

<nav class="issue-nav">
  {
    prev ? (
      <a href={`/issues/${prev.slug}`}>← {prev.title}</a>
    ) : (
      <span class="spacer" />
    )
  }
  {
    next ? (
      <a href={`/issues/${next.slug}`}>{next.title} →</a>
    ) : (
      <span class="spacer" />
    )
  }
</nav>
