---
import type { NormalizedItem } from '../../pipeline/types';
import PaperCard from './PaperCard.astro';
import { slugify } from '../utils/slugify';

interface Props {
  category: string;
  papers: NormalizedItem[];
}

const { category, papers } = Astro.props;
---

<div class="category-section" id={slugify(category)}>
  <h3 class="category-heading">{category}</h3>
  {papers.map((paper) => <PaperCard paper={paper} />)}
</div>
